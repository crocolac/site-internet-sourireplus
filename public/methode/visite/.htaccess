Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, private"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
</IfModule>
<FilesMatch "^(lib\.php|.*\.(json|enc|lock|tmp|zip|ini))$">
  Require all denied
</FilesMatch>
